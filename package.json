{
  "name": "ruckmetrics",
  "version": "0.1.0",
  "private": true,
  "description": "RuckMetrics — configurable bivariate statistical analysis engine for rugby players and teams",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run typecheck",
    "etl": "npm run etl -w @ruckmetrics/ingestion",
    "seed": "npm run seed -w @ruckmetrics/ingestion",
    "api": "npm run dev -w @ruckmetrics/api",
    "web": "npm run dev -w @ruckmetrics/web",
    "dev": "npm run seed && concurrently -n api,web -c blue,green \"npm run api\" \"npm run web\"",
    "build:data": "tsx scripts/export-artifact-data.mts site/data.json",
    "assert:data": "node scripts/assert-data.mjs",
    "build:site": "node scripts/build-site.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "playwright-core": "^1.61.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
